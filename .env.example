# Copie este archivo como .env y rellene las claves.
# Sin claves la aplicación funciona igualmente: usa un evaluador local en lugar de
# Claude y la voz del navegador en lugar de ElevenLabs.

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Operadores del banco que pueden entrar en /panel (usuario:contraseña, separados por comas).
# Si se deja vacío se usa el de demo "operador" / "silvershield-demo" (el servidor avisa al arrancar).
OPERADORES=

# --- Opcional ---
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# ELEVENLABS_VOICE_ID=KHCvMklQZZo0O30ERnVn   # Sara Martin (España). Alternativas: UOIqAnmS11Reiei1Ytkc (Carolina), y6WtESLj18d0diFRruBs (David Martin)
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2   # o eleven_flash_v2_5 (más rápido, menos nítido)
# ELEVENLABS_VELOCIDAD=1
# UMBRAL_VERIFICACION_EUR=500
# PAISES_ALTO_RIESGO=IR,KP,MM,SY,YE,LB,VG,HT,VE,NG,GH,KE,PH
# MAX_TURNOS_VERIFICACION=4
# OPERADOR_SECRETO=        # clave para firmar la sesión; si falta, se genera al arrancar (y las sesiones se cierran al reiniciar)
# OPERADOR_SESION_HORAS=8
